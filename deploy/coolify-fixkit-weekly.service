[Unit]
StartLimitIntervalSec=3600
StartLimitBurst=5
Description=Coolify Healer weekly Now Brief
After=coolify-fixkit-discord.service
Wants=coolify-fixkit-discord.service

[Service]
Type=oneshot
Restart=on-failure
RestartSec=60
ExecStart=/usr/bin/python3 /usr/local/lib/coolify-fixkit/weekly_brief.py
TimeoutStartSec=120
MemoryMax=128M
CPUQuota=25%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
